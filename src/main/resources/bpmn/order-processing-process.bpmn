    <bpmn:sequenceFlow id="Flow_1x5p2nz" sourceRef="Gateway_1yt3ubs" targetRef="Activity_11x6j4p">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApproved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0aenrb4" name="Order Rejected">
