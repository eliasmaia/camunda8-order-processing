    <bpmn:sequenceFlow id="Flow_01qv3zn" sourceRef="Gateway_1yt3ubs" targetRef="Event_0aenrb4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=isApproved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
